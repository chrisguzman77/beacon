# Starts the gateway on boot with no one logged in (hardware guide 5.1 and Appendix C).
# Install: see README.md. Assumes the repo is cloned at /home/beacon/beacon and the Pi user is "beacon"; edit if not.
[Unit]
Description=PlanIT Beacon gateway
After=network.target sound.target
Wants=network.target

[Service]
User=beacon
WorkingDirectory=/home/beacon/beacon/firmware/gateway
ExecStart=/home/beacon/beacon/firmware/gateway/.venv/bin/python -u main.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
